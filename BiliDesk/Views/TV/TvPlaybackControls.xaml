<UserControl x:Class="BiliDesk.Views.TV.TvPlaybackControls" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Foreground="#F5F7FA">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TvStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="24,0,24,25">
        <Border x:Name="Menu" Visibility="Collapsed" HorizontalAlignment="Right" Width="420"
                MaxHeight="295" CornerRadius="10" Background="#FC151C28" Margin="0,0,0,9" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="Options" />
            </ScrollViewer>
        </Border>
        <Border Padding="15" CornerRadius="10" Background="#F21B2432">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="4,0,4,5">
                    <TextBlock x:Name="Clock" DockPanel.Dock="Right" FontSize="19" Margin="14,0,0,0" />
                    <ProgressBar x:Name="Progress" Maximum="1000" Height="7" VerticalAlignment="Center"
                                 Background="#39495D" Foreground="#84E4FF" IsHitTestVisible="False" />
                </DockPanel>
                <WrapPanel x:Name="Commands" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
